# demo | live. Demo enables fictional seed data, role switching and simulated notifications.
APP_ENV=demo
# Leave empty to use the embedded PGlite database in ./.data (development/demo only).
# Set to a Postgres URL for any shared environment. APP_ENV=live requires it.
DATABASE_URL=
# Where private uploads are written (local disk adapter). Never inside /public.
STORAGE_DIR=./.data/uploads
# Session cookie signing/secret material (required in live mode, 32+ chars).
SESSION_SECRET=
# Optional AI extraction for "Paste existing instructions". Without a key, the
# deterministic rule-based parser is used. AI is only permitted with fictional
# data unless AI_PHI_APPROVED=true is set after a documented vendor/data review.
EXTRACTION_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_PHI_APPROVED=false

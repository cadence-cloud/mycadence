# demo | live. Demo enables fictional seed data, role switching and simulated notifications.
APP_ENV=demo
# Leave empty to use the embedded PGlite database in ./.data (development/demo only).
# Set to a Postgres URL for any shared environment. APP_ENV=live requires it.
DATABASE_URL=
# Where private uploads are written (local disk adapter). Never inside /public.
STORAGE_DIR=./.data/uploads
# Session cookie signing/secret material (required in live mode, 32+ chars).
SESSION_SECRET=
# Optional AI extraction for "Paste existing instructions". Without a key, the
# deterministic rule-based parser is used. AI is only permitted with fictional
# data unless AI_PHI_APPROVED=true is set after a documented vendor/data review.
EXTRACTION_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_PHI_APPROVED=false

# Public URL of the app (used in email links and webhook URLs)
APP_URL=http://localhost:3000

# Calendly: webhook signing key from your Calendly webhook subscription
# (events: invitee.created, invitee.canceled -> /api/integrations/calendly)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Email notifications (generic wording only). EMAIL_PROVIDER=smtp works with any SMTP
# service; choose one that will sign a BAA before real patients.
EMAIL_PROVIDER=
SMTP_URL=
EMAIL_FROM="Cadence Physical Therapy <notifications@example.com>"
# Replies by email: Reply-To becomes reply+<token>@EMAIL_REPLY_DOMAIN; the provider's
# inbound webhook posts to /api/integrations/email/inbound with this secret.
EMAIL_REPLY_DOMAIN=
INBOUND_EMAIL_SECRET=
